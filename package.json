{
  "name": "verify",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "存证链独立核验站与核验库",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "test": "vitest",
    "verify:py": "python3 scripts/verify_evidence_package.py tests/fixtures/golden-evidence-package.zip",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "vue": "3.5.27",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.0.1",
    "@types/node": "25.0.9",
    "@vitejs/plugin-vue": "6.0.3",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.2",
    "eslint-plugin-format": "1.3.1",
    "happy-dom": "20.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.17",
    "vue-tsc": "3.2.2",
    "wrangler": "4.148.0"
  }
}
